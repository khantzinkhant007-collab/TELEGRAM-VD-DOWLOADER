# =============================================================================
# Telegram Video Batch Downloader — Environment Configuration Template
# Copy this file to `.env` for local development (`cp .env.example .env`).
# NEVER commit your actual `.env` file or real credentials to version control.
# =============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# In production, set this to a random secret with at least 32 characters.
# It encrypts each browser's Telegram session cookie and must be identical on all instances.
# The local development server generates a temporary secret automatically when this is blank.
TELEGRAM_COOKIE_SECRET=

# Security & Rate Limiting Settings
ALLOWED_ORIGINS=http://localhost:3000
MAX_BATCH_SIZE=25
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
